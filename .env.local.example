# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never deployed.

# Required: password for /admin
ADMIN_PASSWORD=change-me-pick-something-long

# Optional: when set, /api/save-content commits to GitHub instead of writing locally.
# Leave unset during local development (writes to ./content.json directly).
# GITHUB_TOKEN=ghp_xxx_fine_grained_pat_with_contents_write
# GITHUB_REPO=username/daniel-portfolio
# GITHUB_BRANCH=main

# Cloudinary — both vars are exposed to the browser (unsigned uploads).
# Get cloud name from Cloudinary dashboard.
# Create an unsigned upload preset (Settings → Upload → Upload presets) with:
#   - signing mode: unsigned
#   - asset folder: portfolio
#   - allowed formats: jpg,png,webp,gif,svg
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxx
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=portfolio_uploads

# Server-only (NEVER prefix NEXT_PUBLIC_) — needed by /api/delete-image to call Cloudinary destroy.
# Create at Cloudinary → Settings → API Keys. Use Tech Admin role.
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
